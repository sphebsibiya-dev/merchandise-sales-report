		sourceColumn: Order Date

		variation Variation
			isDefault
			relationship: 2a4014b0-6a44-469b-b17b-818fff28c056
			defaultHierarchy: LocalDateTable_3ec40eff-8e57-44f2-b907-05fec648ce5e.'Date Hierarchy'

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

