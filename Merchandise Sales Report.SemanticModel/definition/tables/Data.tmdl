table Data
	lineageTag: 2831593c-0126-4353-8a4b-98986f3b0cbe

	/// Total amount charged to buyers, including international shipping fees. Sum of the Total Sales column.
	measure Sales = SUM ( Data[Total Sales] )
		formatString: $#,##0
		displayFolder: Sales
		lineageTag: 98f5f3a6-13e2-4068-869a-42dd90a10241

	/// Sales excluding shipping fees: price tag times quantity.
	measure 'Product Revenue' = SUMX ( Data, Data[Sales Price] * Data[Quantity] )
		formatString: $#,##0
		displayFolder: Sales
		lineageTag: a8d2e27e-5ee1-4c20-b609-7fe055dc3c4e

	/// International shipping fees charged. The fee applies per unit, so it is Shipping Charges times Quantity.
	measure 'Shipping Revenue' = SUMX ( Data, Data[Shipping Charges] * Data[Quantity] )
		formatString: $#,##0
		displayFolder: Shipping
		lineageTag: db307aea-5bd9-4742-883e-07389593f1ef

	/// Number of orders; the data has one row per order.
	measure Orders = COUNTROWS ( Data )
		formatString: #,##0
		displayFolder: Sales
		lineageTag: 1db2bc00-bf46-46ed-969f-86dd58acd6a9

	/// Total quantity of items bought.
	measure 'Units Sold' = SUM ( Data[Quantity] )
		formatString: #,##0
		displayFolder: Sales
		lineageTag: 25d15a08-87f7-4891-8b3f-1b65d8b99fc1

	/// Sales divided by number of orders, shipping included.
	measure 'Avg Order Value' = DIVIDE ( [Sales], [Orders] )
		formatString: $#,##0.00
		displayFolder: Sales
		lineageTag: 1e47ded6-33a2-4ee8-bca9-85a47b242cc7

	/// Average quantity per order.
	measure 'Units per Order' = DIVIDE ( [Units Sold], [Orders] )
		formatString: 0.00
		displayFolder: Buyers
		lineageTag: d18c30d5-8d33-4aa6-a72c-e031bd10ded6

	/// Average order rating on a 1 to 5 scale.
	measure 'Avg Rating' = AVERAGE ( Data[Rating] )
		formatString: 0.00
		displayFolder: Reviews
		lineageTag: 1f0833bb-23f7-421f-be45-eb355ce99a6d

	/// Share of orders rated 4 or 5.
	measure 'Positive Review %' = DIVIDE ( CALCULATE ( [Orders], KEEPFILTERS ( Data[Rating] >= 4 ) ), [Orders] )
		formatString: 0.0%
		displayFolder: Reviews
		lineageTag: 12159188-4304-4250-adc0-cfd220b9531a

	/// Share of orders rated 1 or 2.
	measure 'Negative Review %' = DIVIDE ( CALCULATE ( [Orders], KEEPFILTERS ( Data[Rating] <= 2 ) ), [Orders] )
		formatString: 0.0%
		displayFolder: Reviews
		lineageTag: 71688dfb-c1d2-43e6-a2f8-db136f84e183

	/// Proxy for discount impact: share of orders whose review praises discount deals or affordability. The data has no discount field; every product has a single price.
	measure 'Price Praise %' =
			DIVIDE (
			    CALCULATE (
			        [Orders],
			        KEEPFILTERS (
			            Data[Review]
			                IN {
			                    "Discount deals was greatly appreciated.",
			                    "The product was affordable here compared to other brands."
			                }
			        )
			    ),
			    [Orders]
			)
		formatString: 0.0%
		displayFolder: Reviews
		lineageTag: 3d037b1a-a9a1-42ca-9d47-e522a4cb60b9

	/// Share of orders shipped outside the United States.
	measure 'International Orders %' = DIVIDE ( CALCULATE ( [Orders], KEEPFILTERS ( Data[Market] = "International" ) ), [Orders] )
		formatString: 0.0%
		displayFolder: Shipping
		lineageTag: b6be4030-bfbc-4598-bda1-d92931aaab67

	/// Share of sales (shipping included) from orders shipped outside the United States.
	measure 'International Sales %' = DIVIDE ( CALCULATE ( [Sales], KEEPFILTERS ( Data[Market] = "International" ) ), [Sales] )
		formatString: 0.0%
		displayFolder: Shipping
		lineageTag: 980eb410-a600-48d2-b2a7-28a5d69490d0

	/// Share of international sales that is shipping fees rather than product revenue.
	measure 'Shipping % of International Sales' =
			DIVIDE (
			    CALCULATE ( [Shipping Revenue], KEEPFILTERS ( Data[Market] = "International" ) ),
			    CALCULATE ( [Sales], KEEPFILTERS ( Data[Market] = "International" ) )
			)
		formatString: 0.0%
		displayFolder: Shipping
		lineageTag: 84578625-d214-4b0b-921d-6487782ae0b9

	/// Average age of the buyer across orders.
	measure 'Avg Buyer Age' = AVERAGE ( Data[Buyer Age] )
		formatString: 0.0
		displayFolder: Buyers
		lineageTag: 4ac70ea0-f997-4e54-9a5f-ed76ee6c63cc

	/// Share of orders placed by male buyers.
	measure 'Male Buyer %' = DIVIDE ( CALCULATE ( [Orders], KEEPFILTERS ( Data[Buyer Gender] = "Male" ) ), [Orders] )
		formatString: 0.0%
		displayFolder: Buyers
		lineageTag: db7fef05-9833-4431-a181-6273d302969a

	/// Proxy for repeat purchasing: share of orders with quantity above 1. The data has no customer ID, so true repeat purchases cannot be measured.
	measure 'Multi-Unit Order %' = DIVIDE ( CALCULATE ( [Orders], KEEPFILTERS ( Data[Quantity] > 1 ) ), [Orders] )
		formatString: 0.0%
		displayFolder: Buyers
		lineageTag: 1ee8b370-2e0e-42a9-9025-3f8f05e9e32f

	column 'Order ID'
		dataType: int64
		formatString: 0
		lineageTag: 0c916d6c-e697-484e-85ea-d72b43f4c10e
		summarizeBy: none
		sourceColumn: Order ID

		annotation SummarizationSetBy = Automatic

	column 'Order Date'
