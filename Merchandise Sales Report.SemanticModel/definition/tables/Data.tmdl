		annotation SummarizationSetBy = Automatic

	/// Country of the order city, derived from Order Location.
	column Country =
			SWITCH (
			    TRUE (),
			    Data[Order Location] IN { "London", "Manchester", "Liverpool", "Cardiff", "Glasgow" }, "United Kingdom",
			    Data[Order Location] = "Dublin", "Ireland",
			    Data[Order Location] IN { "Toronto", "Montreal" }, "Canada",
			    Data[Order Location] = "Paris", "France",
			    Data[Order Location] IN { "Mumbai", "New Delhi" }, "India",
			    Data[Order Location] = "Sydney", "Australia",
			    "United States"
			)
		dataType: string
		lineageTag: c6be32f2-56c2-4947-8565-05d6cbad80e0
		dataCategory: Country
		summarizeBy: none

	/// Domestic (United States, no shipping fee) or International, from the International Shipping flag.
	column Market = IF ( Data[International Shipping] = "Yes", "International", "Domestic" )
		dataType: string
		lineageTag: 6b20d648-74ec-428c-9119-9573a5925807
		summarizeBy: none

	/// Buyer age band: 18-20, 21-25, 26-30, 31-35.
	column 'Age Group' =
			SWITCH (
			    TRUE (),
			    Data[Buyer Age] <= 20, "18-20",
			    Data[Buyer Age] <= 25, "21-25",
			    Data[Buyer Age] <= 30, "26-30",
			    "31-35"
			)
		dataType: string
		lineageTag: 5655e346-1a7a-4e50-afb5-b0ce1cfb34fd
		summarizeBy: none

	/// Sort order for Sentiment.
	column 'Sentiment Order' = SWITCH ( TRUE (), Data[Rating] >= 4, 1, Data[Rating] = 3, 2, 3 )
		dataType: int64
		isHidden
		lineageTag: d3827fdb-52aa-48b4-8a52-744aee160b38
		summarizeBy: none

	/// Positive for ratings 4-5, Neutral for 3, Negative for 1-2.
	column Sentiment = SWITCH ( TRUE (), Data[Rating] >= 4, "Positive", Data[Rating] = 3, "Neutral", "Negative" )
		dataType: string
		lineageTag: bf699cd2-6742-4993-8fe4-60a3b01b3678
		summarizeBy: none
		sortByColumn: 'Sentiment Order'

	/// Topic of the review sentence: Delivery, Quality, Design, Price and Discounts, or General.
	column 'Review Theme' =
			VAR r = LOWER ( Data[Review] )
			RETURN
			    SWITCH (
			        TRUE (),
			        CONTAINSSTRING ( r, "deliver" ) || CONTAINSSTRING ( r, "handling" ) || CONTAINSSTRING ( r, "delays" ), "Delivery",
			        CONTAINSSTRING ( r, "discount" ) || CONTAINSSTRING ( r, "affordable" ) || CONTAINSSTRING ( r, "money" ) || CONTAINSSTRING ( r, "promotion" ), "Price and Discounts",
			        CONTAINSSTRING ( r, "design" ) || CONTAINSSTRING ( r, "detailing" ), "Design",
			        CONTAINSSTRING ( r, "quality" ) || CONTAINSSTRING ( r, "craftsmanship" ), "Quality",
			        "General"
			    )
		dataType: string
		lineageTag: f4ab7e07-817b-4f63-a0ac-88455bf1ec8a
		summarizeBy: none

	/// Single unit when Quantity is 1, otherwise Multi-unit.
	column 'Order Size' = IF ( Data[Quantity] > 1, "Multi-unit", "Single unit" )
		dataType: string
		lineageTag: 106781ac-fef4-49b7-8816-242065475b63
		summarizeBy: none

	partition Data = m
		mode: import
		source =
				let
				  Source = Excel.Workbook(File.Contents("C:\Users\Sphesihle Sibiya\Power Bi\Merchandise Sales Dataset\WgsUBfjr5GWNOHRpFmBP6oKmUDm5T53pipHgRQhh\Onyx Data -DataDNA Dataset Challenge - Merchandise Sales Dataset - January 2025.xlsx"), null, true),
				  #"Navigation 1" = Source{[Item = "Data", Kind = "Sheet"]}[Data],
				  #"Promoted headers" = Table.PromoteHeaders(#"Navigation 1", [PromoteAllScalars = true]),
				  #"Changed column type" = Table.TransformColumnTypes(#"Promoted headers", {{"Order ID", Int64.Type}, {"Order Date", type date}, {"Product ID", type text}, {"Product Category", type text}, {"Buyer Gender", type text}, {"Buyer Age", Int64.Type}, {"Order Location", type text}, {"Latitude", type number}, {"Longitude", type number}, {"International Shipping", type text}, {"Sales Price", Int64.Type}, {"Shipping Charges", Int64.Type}, {"Sales per Unit", Int64.Type}, {"Quantity", Int64.Type}, {"Total Sales", Int64.Type}, {"Rating", Int64.Type}, {"Review", type text}})
				in
				  #"Changed column type"

	annotation PBI_ResultType = Table

